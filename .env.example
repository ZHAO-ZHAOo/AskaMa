# Copy to .env for local runs. On Render, set these under Environment instead.
# Never commit .env — it is git-ignored.

# Required for LLM intake. Must be created in the Singapore region of
# Alibaba Cloud Model Studio (Bailian). Without it the app uses keyword rules.
DASHSCOPE_API_KEY=

# Optional. Only the workspace ID itself (e.g. ws-xxxxx), not a URL.
# Leave empty to use https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WORKSPACE_ID=

# Optional. Defaults shown.
LLM_MODEL=qwen3.8-max
LLM_TIMEOUT=10
# LLM_ENABLE_THINKING=1   # turn on Qwen thinking mode (much slower: 12-31s)
# LLM_INTAKE_ENABLED=0    # skip the LLM and use keyword rules only
# LLM_BASE_URL=           # override the endpoint entirely
